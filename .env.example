# ==============================================================================
# Project1A: Autonomous Financial Research Agent (ARA-1) Environment Configuration
# ==============================================================================

# Primary LLM API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Financial & Market Data APIs
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
FMP_API_KEY=your_financial_modeling_prep_key_here
SEC_EDGAR_USER_AGENT="QuantumEdgeResearch intern@quantumedge.com"

# Web Search APIs
TAVILY_API_KEY=your_tavily_api_key_here
SERPAPI_API_KEY=your_serpapi_api_key_here
NEWS_API_KEY=your_newsapi_org_key_here

# Vector Storage Configuration
VECTOR_DB_TYPE=chroma # Options: chroma, pinecone, weaviate
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=ara1-financial-research

# Model Runtime Settings
DEFAULT_LLM_MODEL=gpt-4o-mini
REASONING_LLM_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
MAX_TOOL_CALLS_PER_TASK=20
TEMPERATURE=0.1
LOG_LEVEL=INFO
